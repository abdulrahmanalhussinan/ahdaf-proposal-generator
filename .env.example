# انسخ هذا الملف باسم .env في مجلد المشروع نفسه وعدّل القيم عند الحاجة.
# Copy to .env next to this file. Secrets stay on the server and are never sent to the browser.

# --- Server
AHDAF_HOST=127.0.0.1
AHDAF_PORT=8765
# Where the database, uploads and exports are stored (default: ./data)
# AHDAF_DATA_DIR=D:\AhdafData

# --- AI writing (optional)
# rules  = built-in writing engine only (default when no key)
# claude = polish generated text with Claude (requires a key)
# auto   = Claude when a key is present, otherwise rules
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- PDF rendering browser (Microsoft Edge ships with Windows)
PDF_BROWSER_CHANNEL=msedge
